{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taptry-ops",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Nobody reaches the Worker except through the two custom domains below:
  // ops.taptry.in needs the dashboard password; ingest.taptry.in checks HMAC.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "ops.taptry.in", "custom_domain": true },
    { "pattern": "ingest.taptry.in", "custom_domain": true }
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "taptry-ops", "database_id": "37062f62-2f73-4dda-a81e-b8b11187bc57", "migrations_dir": "migrations" }
  ],
  // Cloudflare crons run in UTC. 03:00 UTC = 8:30 AM IST.
  "triggers": { "crons": ["*/15 * * * *", "5 * * * *", "0 3 * * *"] },
  "vars": {
    "POSTHOG_HOST": "https://us.posthog.com",
    "POSTHOG_DASHBOARDS": "2090168,2090237",
    "AWS_REGIONS": "ap-south-1,eu-north-1"
  }
  // Secrets (set with `wrangler secret put NAME` or in the dashboard, never here):
  // DASH_PASSWORD, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, POSTHOG_API_KEY
}
